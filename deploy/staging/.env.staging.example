# Staging (test.mishkaznaet.ru). Скопируйте в /var/www/tutor-ai-staging/.env.local
# НЕ используйте прод-секреты и прод-БД.

# --- Google Gemini ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODELS=gemma-4-31b-it,gemma-4-26b-a4b-it

# --- Сессии (JWT). Отдельный от прода! openssl rand -base64 32 (мин. 32 символа) ---
JWT_SECRET=

# --- Канонический URL staging ---
NEXT_PUBLIC_APP_URL=https://test.mishkaznaet.ru

# --- Яндекс ID OAuth ---
# В oauth.yandex.ru добавьте Redirect URI: https://test.mishkaznaet.ru/api/auth/yandex/callback
# (в существующее приложение или отдельное staging-приложение)
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
YANDEX_OAUTH_REDIRECT_URI=https://test.mishkaznaet.ru/api/auth/yandex/callback

# --- Яндекс Метрика: на staging выключаем, чтобы не портить статистику прода ---
NEXT_PUBLIC_YANDEX_METRIKA_DISABLED=1
# NEXT_PUBLIC_YANDEX_METRIKA_ID=

# --- Отдельные БД и хранилище (вне каталога проекта, переживают деплой) ---
DATABASE_PATH=/var/lib/tutor-ai-staging/database.db
CHAT_UPLOADS_PATH=/var/lib/tutor-ai-staging/chat-uploads

# --- robots.txt: Disallow: / для всего сайта (читается при сборке) ---
ROBOTS_DISALLOW_ALL=1

# --- Лимиты использования ---
# USAGE_QUOTA_DISABLED=1
USAGE_FREE_CHAT_PER_DAY=16
# Полный список USAGE_FREE_*/USAGE_PLUS_* — см. .env.local.example в корне
# USAGE_QUOTA_EXEMPT_EMAILS=
# USAGE_QUOTA_EXEMPT_USER_IDS=

# Вероятность задачи из банка (0..1)
# TASK_BANK_MIX_RATE=0.5
